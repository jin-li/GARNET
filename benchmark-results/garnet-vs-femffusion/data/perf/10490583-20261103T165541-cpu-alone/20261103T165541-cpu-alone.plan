after cpu-hpmr-r3z40-alone assess_garnet_vs_femffusion.py hpmr3d --mesh 3 --nz 40 --precond-degree 0 --anderson-depth 8 --tol-k 1e-7 --tol-source 1e-6 --repeats 3 --output @OUT@
